#!/bin/sh
# Blocks the commit when a major directory (tracked, not hidden, up to 3 levels deep) has no README.md.
# Enable once per clone: git config core.hooksPath .githooks

max_depth=3
missing=$(
  git ls-files | xargs -n1 dirname | sort -u \
    | awk -F/ -v max="$max_depth" '$0 != "." && NF <= max && $0 !~ /(^|\/)\./' \
    | while read -r dir; do
        git ls-files --error-unmatch "$dir/README.md" >/dev/null 2>&1 || echo "  $dir"
      done
)

if [ -n "$missing" ]; then
  echo "Commit blocked: these directories need a README.md (Purpose, Contents, How it connects, Conventions):"
  echo "$missing"
  exit 1
fi
